# Copy to .env to enable the live AI brain. Without a key the app still runs a
# complete grounded analysis from free data feeds and the knowledge base.

# OpenAI GPT-5 brain (Responses API + web_search tool).
# Powerful but cheap default: gpt-5-mini. Cheapest: gpt-5-nano.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Set to 1 to disable internet web search by the model.
OPENAI_DISABLE_WEB_SEARCH=

# Optional second provider (adds a prospector/skeptic split).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-1-20250805

PORT=8080
