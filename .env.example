# Copy to .env and fill in to enable live dual-AI analysis.
# Without keys the app runs in deterministic "demo AI" mode (full pipeline,
# heuristic narratives) so everything still works end-to-end.

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-1-20250805

# OpenAI (GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server
PORT=8080
