# Supabase — required for the submissions database + screenshot storage.
# Find these in your Supabase project: Settings > API.

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (server-side only, NEVER expose to the browser).
# Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to authorize the /admin winner-picker (choose any long random string).
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=
